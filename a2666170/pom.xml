<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.edu.utfpr.sd</groupId>
    <artifactId>agenda-salas</artifactId>
    <version>0.1.0</version>
    <name>Sistema de Agendamento de Salas</name>

    <properties>
        <maven.compiler.release>26</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <javafx.version>26.0.2</javafx.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.3.0</version>
        </dependency>
        <!-- Silencia o aviso de log do sqlite-jdbc -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.17</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!-- Console: mvn exec:java@servidor  |  mvn exec:java@cliente
                 Interface grafica: mvn exec:java@servidor-gui  |  mvn exec:java@cliente-gui -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>servidor</id>
                        <configuration>
                            <mainClass>br.edu.utfpr.sd.servidor.Servidor</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cliente</id>
                        <configuration>
                            <mainClass>br.edu.utfpr.sd.cliente.Cliente</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>servidor-gui</id>
                        <configuration>
                            <mainClass>br.edu.utfpr.sd.servidor.ServidorGui</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cliente-gui</id>
                        <configuration>
                            <mainClass>br.edu.utfpr.sd.cliente.ClienteGui</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
